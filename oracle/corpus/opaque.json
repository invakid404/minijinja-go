        { "name": "member", "value": { "kind": "opaque_map", "canonical": "RED", "display": "rouge" } }
      ],
      "expect": "bytes",
      "notes": "The control: a one-element sort never compares anything, so it succeeds and renders the element. The fault is in the comparison, not in the presence of an opaque map."
    },
    {
      "id": "opaque/empty-map-list",
      "surface": "container",
      "form": "expression",
      "source": "e|list",
