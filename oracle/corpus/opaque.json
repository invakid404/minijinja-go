      "notes": "The control the previous row is measured against: an ordinary empty mapping is falsey."
    },
    {
      "id": "opaque/member-for-loop",
      "surface": "container",
      "form": "template",
      "source": "{% for x in member %}{{ x }}{% endfor %}",
