    {
      "id": "num/add-2pow53-plus-one",
      "surface": "arithmetic",
      "form": "expression",
      "source": "9007199254740993 + 1",
      "expect": "bytes",
      "notes": "2^53+1 is not representable in f64. The engine adds in checked i128; routing the operands through float64 collapsed 2^53+1 onto 2^53 and answered 9007199254740992."
    },
    {
      "id": "num/sub-2pow53-adjacent",
